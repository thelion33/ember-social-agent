# Copy to .env and fill in. .env is gitignored and must never be committed.
# In GitHub Actions these come from repository secrets instead.

# --- Content generation ---------------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.5 when unset.
OPENAI_MODEL=

# --- X / Twitter ----------------------------------------------------------
# OAuth 1.0a user context, from the X developer portal app's "Keys and tokens".
# The app must have Read and Write permissions; regenerate the access token
# AFTER changing permissions or it keeps the old read-only scope.
# Leave all five blank to disable X publishing entirely; the agent will report
# X as unconfigured and post to Instagram only.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# App-only token. Used for read probes; cannot upload media or post.
X_BEARER_TOKEN=

# --- Instagram ------------------------------------------------------------
# Two flavors are supported and detected automatically at runtime:
#   * Token beginning with "IGAA"  -> Instagram Login, routed to graph.instagram.com
#   * Any other token              -> Facebook Login, routed to graph.facebook.com
INSTAGRAM_ACCESS_TOKEN=
# For graph.instagram.com this is the Instagram-scoped user id.
# For graph.facebook.com this must be the IG BUSINESS ACCOUNT id, not the Page id.
INSTAGRAM_USER_ID=

# --- Image hosting --------------------------------------------------------
# Instagram fetches images over the public internet, so rendered cards are
# uploaded to GitHub release assets first. The repo below MUST be public or
# Instagram's fetcher gets a 404.
#
# NOTE: GitHub secret names may not begin with "GITHUB_". In Actions this is
# stored as the secret GH_ASSETS_TOKEN and mapped to GITHUB_TOKEN in the
# workflow env block.
GITHUB_TOKEN=
GH_ASSETS_REPO=thelion33/ember-social-agent
GH_ASSETS_TAG=post-assets

# --- Scheduling -----------------------------------------------------------
# IANA timezone name. Drives the posting calendar and the catch-up window.
TIMEZONE=America/New_York
